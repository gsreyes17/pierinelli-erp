<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_financial_report_wizard_form" model="ir.ui.view">
        <field name="name">pierinelli.financial.report.wizard.form</field>
        <field name="model">pierinelli.financial.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Estados Financieros">
                <sheet>
                    <div class="oe_title">
                        <h1>Estados Financieros</h1>
                        <p class="text-muted">
                            Genera los estados financieros de la compania segun el
                            Plan Contable General Empresarial (PCGE). Elige el rango
                            de fechas y luego el reporte que deseas imprimir.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="target_move" widget="radio"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Estados financieros"/>
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <button name="action_financial_position" type="object"
                                string="Balance General" class="btn-primary text-nowrap"
                                icon="fa-balance-scale"/>
                        <button name="action_income_statement" type="object"
                                string="Estado de Resultados" class="btn-primary text-nowrap"
                                icon="fa-line-chart"/>
                        <button name="action_cash_flow" type="object"
                                string="Flujo de Caja" class="btn-primary text-nowrap"
                                icon="fa-money"/>
                        <button name="action_ratios" type="object"
                                string="Indicadores Financieros" class="btn-primary text-nowrap"
                                icon="fa-tachometer"/>
                    </div>
                    <separator string="Libros contables"/>
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <button name="action_journal_book" type="object"
                                string="Libro Diario" class="btn-secondary text-nowrap"
                                icon="fa-calendar"/>
                        <button name="action_general_ledger" type="object"
                                string="Libro Mayor" class="btn-secondary text-nowrap"
                                icon="fa-book"/>
                        <button name="action_trial_balance" type="object"
                                string="Balance de Comprobacion" class="btn-secondary text-nowrap"
                                icon="fa-table"/>
                    </div>
                    <separator string="Gestion e impuestos"/>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button name="action_aged_receivable" type="object"
                                string="Antiguedad CxC (clientes)" class="btn-secondary text-nowrap"
                                icon="fa-users"/>
                        <button name="action_aged_payable" type="object"
                                string="Antiguedad CxP (proveedores)" class="btn-secondary text-nowrap"
                                icon="fa-truck"/>
                        <button name="action_tax_summary" type="object"
                                string="Resumen de IGV" class="btn-secondary text-nowrap"
                                icon="fa-percent"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_financial_report_wizard" model="ir.actions.act_window">
        <field name="name">Estados Financieros</field>
        <field name="res_model">pierinelli.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
