<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_tipo_cambio_actualizar" model="ir.actions.act_window">
        <field name="name">Actualizar desde SUNAT</field>
        <field name="res_model">pierinelli.tipo.cambio.actualizar</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============ TIPOS DE CAMBIO ============ -->
    <record id="view_tipo_cambio_list" model="ir.ui.view">
        <field name="name">pierinelli.tipo.cambio.list</field>
        <field name="model">pierinelli.tipo.cambio</field>
        <field name="arch" type="xml">
            <list default_order="fecha desc, origen"
                  decoration-info="origen == 'sunat'">
                <header>
                    <!-- display="always" es OBLIGATORIO: sin el, Odoo 19 solo
                         muestra los botones de header de lista cuando hay filas
                         seleccionadas, y en una tabla vacia (BD recien creada)
                         el boton no existe para el usuario. -->
                    <button name="%(action_tipo_cambio_actualizar)d" type="action"
                            string="Actualizar desde SUNAT" class="btn-primary"
                            display="always"
                            groups="account.group_account_manager,base.group_system"/>
                </header>
                <field name="fecha"/>
                <field name="origen" widget="badge"
                       decoration-info="origen == 'sunat'"
                       decoration-warning="origen == 'corporativa'"/>
                <field name="compra"/>
                <field name="venta"/>
                <field name="actualizado_automaticamente" optional="show"/>
                <field name="fecha_actualizacion" optional="hide"/>
                <field name="notas" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_tipo_cambio_form" model="ir.ui.view">
        <field name="name">pierinelli.tipo.cambio.form</field>
        <field name="model">pierinelli.tipo.cambio</field>
        <field name="arch" type="xml">
            <form string="Tipo de cambio">
                <sheet>
                    <div class="oe_title">
                        <h1>Tipo de cambio USD / PEN</h1>
                        <p class="text-muted">
                            Selecciona el origen antes de guardar: SUNAT para la
                            referencia oficial o Corporativa para la tasa propia.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="fecha"/>
                            <field name="origen" widget="radio"/>
                            <field name="notas"
                                   placeholder="Ej. Tasa de caja aprobada"/>
                        </group>
                        <group string="Soles por US$ 1">
                            <field name="compra"/>
                            <field name="venta"/>
                            <field name="actualizado_automaticamente" readonly="1"/>
                            <field name="fecha_actualizacion" readonly="1"
                                   invisible="not actualizado_automaticamente"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tipo_cambio_kanban" model="ir.ui.view">
        <field name="name">pierinelli.tipo.cambio.kanban</field>
        <field name="model">pierinelli.tipo.cambio</field>
        <field name="arch" type="xml">
            <kanban default_order="fecha desc, origen" class="o_kanban_mobile">
                <field name="origen"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong><field name="fecha"/></strong>
                                <span t-attf-class="badge #{record.origen.raw_value == 'sunat' ? 'text-bg-info' : 'text-bg-warning'}">
                                    <field name="origen"/>
                                </span>
                            </div>
                            <div class="mt-2 d-flex gap-4">
                                <div>
                                    <div class="text-muted small">Venta</div>
                                    <span class="h4"><field name="venta"/></span>
                                </div>
                                <div>
                                    <div class="text-muted small">Compra</div>
                                    <span class="h5 text-muted"><field name="compra"/></span>
                                </div>
                            </div>
                            <div class="text-muted small mt-1">
                                <field name="notas"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_tipo_cambio" model="ir.actions.act_window">
        <field name="name">Tipos de Cambio</field>
        <field name="res_model">pierinelli.tipo.cambio</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin tasas registradas</p>
            <p>Registra aqui la tasa SUNAT del dia (compra y venta) y la tasa
               corporativa de Pierinelli. En la factura en dolares, el vendedor
               elige cual aplicar y el sistema registra cual se uso.</p>
        </field>
    </record>

    <record id="view_tipo_cambio_actualizar_form" model="ir.ui.view">
        <field name="name">pierinelli.tipo.cambio.actualizar.form</field>
        <field name="model">pierinelli.tipo.cambio.actualizar</field>
        <field name="arch" type="xml">
            <form string="Actualizar tipo de cambio SUNAT">
                <group>
                    <p>Se consultará la publicación diaria oficial de SUNAT y se registrará la última fecha disponible. Si ya existe una tasa SUNAT ingresada manualmente para esa fecha, se conserva.</p>
                    <p class="text-muted">SUNAT puede no publicar una tasa en días no hábiles. El ingreso manual permanece disponible como respaldo.</p>
                </group>
                <footer>
                    <button name="action_actualizar" type="object" string="Consultar SUNAT" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <menuitem id="menu_tipo_cambio" name="Tipos de Cambio"
              parent="account.menu_finance_configuration"
              action="action_tipo_cambio" sequence="30"
              groups="account.group_account_user"/>

    <!-- Origen de la tasa en la factura: panel propio, aireado, debajo del
         bloque de moneda (la fila nativa de la tasa es un flex apretado). -->
    <record id="view_move_form_origen_tasa" model="ir.ui.view">
        <field name="name">account.move.form.origen.tasa</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='currency_div']" position="after">
                <div name="tasa_pierinelli" class="w-100 mt-2 p-2 rounded"
                     style="background: rgba(201, 150, 47, 0.07); border-left: 3px solid #C9962F;"
                     invisible="currency_id == company_currency_id or move_type == 'entry'">

                    <!-- Cabecera: titulo + interruptor para plegar/desplegar -->
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="o_form_label fw-bold">
                            <i class="fa fa-exchange me-1" title="Tipo de cambio"/> Tipo de cambio
                        </div>
                        <div class="d-flex align-items-center" invisible="state != 'draft'">
                            <span class="text-muted small me-2"
                                  invisible="not mostrar_opciones_tasa">Cerrar</span>
                            <span class="text-muted small me-2"
                                  invisible="mostrar_opciones_tasa">Cambiar</span>
                            <field name="mostrar_opciones_tasa"
                                   widget="boolean_toggle" nolabel="1"/>
                        </div>
                    </div>

                    <!-- Opciones (solo con el panel desplegado). Al elegir una,
                         el compute de mostrar_opciones_tasa lo pliega solo. -->
                    <div invisible="not mostrar_opciones_tasa">
                        <field name="origen_tasa" widget="radio"
                               readonly="state != 'draft'" nolabel="1"/>
                        <div class="text-muted small" invisible="origen_tasa">
                            Elige que tasa aplicar. Se administran en
                            Configuracion → Tipos de Cambio.
                        </div>
                    </div>

                    <!-- Resumen compacto: sirve igual plegado que desplegado -->
                    <div class="text-muted small mt-1" invisible="not resumen_tasa">
                        Tasa aplicada:
                        <field name="resumen_tasa" readonly="1" nolabel="1"
                               class="oe_inline fw-bold"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- ============ PLANTILLAS DE ASIENTOS ============ -->
    <record id="view_plantilla_asiento_form" model="ir.ui.view">
        <field name="name">pierinelli.plantilla.asiento.form</field>
        <field name="model">pierinelli.plantilla.asiento</field>
        <field name="arch" type="xml">
            <form string="Plantilla de asiento">
                <header>
                    <button name="action_usar" type="object"
                            string="Generar asiento" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"
                                   placeholder="Ej. Planilla mensual"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="journal_id"/>
                            <field name="descripcion"/>
                        </group>
                    </group>
                    <field name="linea_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="account_id"/>
                            <field name="name"/>
                            <field name="lado"/>
                            <field name="modo"/>
                            <field name="valor"/>
                        </list>
                    </field>
                    <p class="text-muted">
                        Con "% del importe base", al generar el asiento se pide
                        un importe (ej. total de la planilla) y cada linea toma
                        su porcentaje. Debe y Haber deben cuadrar.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_plantilla_asiento_list" model="ir.ui.view">
        <field name="name">pierinelli.plantilla.asiento.list</field>
        <field name="model">pierinelli.plantilla.asiento</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="descripcion"/>
                <field name="journal_id"/>
                <button name="action_usar" type="object" string="Generar"
                        icon="fa-bolt" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="action_plantilla_asiento" model="ir.actions.act_window">
        <field name="name">Plantillas de Asientos</field>
        <field name="res_model">pierinelli.plantilla.asiento</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin plantillas</p>
            <p>Define una vez las lineas del asiento repetitivo (planilla,
               depreciacion, provisiones) y generalo cada mes en dos clics.</p>
        </field>
    </record>

    <menuitem id="menu_plantilla_asiento" name="Plantillas de Asientos"
              parent="account.menu_finance_entries"
              action="action_plantilla_asiento" sequence="30"
              groups="account.group_account_user"/>

    <!-- Wizard Generar asiento -->
    <record id="view_plantilla_usar_form" model="ir.ui.view">
        <field name="name">pierinelli.plantilla.usar.form</field>
        <field name="model">pierinelli.plantilla.usar</field>
        <field name="arch" type="xml">
            <form string="Generar asiento">
                <group>
                    <field name="plantilla_id" readonly="1"/>
                    <field name="fecha"/>
                    <field name="ref"/>
                    <field name="importe_base"/>
                </group>
                <footer>
                    <button name="action_generar" type="object"
                            string="Generar borrador" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
