<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Estilos y encabezado comun de los estados financieros Pierinelli -->
    <template id="financial_report_styles">
        <style>
            .pierinelli-fin { font-size: 10px; color: #111111; }
            .pierinelli-fin h2 { color: #111111; font-size: 18px; margin-bottom: 2px; }
            .pierinelli-fin .subtitle { color: #C9962F; font-weight: bold; letter-spacing: .5px; }
            .pierinelli-fin .fin-meta { color: #555; font-size: 9px; }
            .pierinelli-fin table { width: 100%; border-collapse: collapse; }
            .pierinelli-fin th {
                background: #111111; color: #fff; padding: 5px 6px;
                text-align: left; font-size: 9px; text-transform: uppercase;
                letter-spacing: .3px;
            }
            .pierinelli-fin td { padding: 3px 6px; border-bottom: 1px solid #eee; }
            .pierinelli-fin .num { text-align: right; font-variant-numeric: tabular-nums; }
            .pierinelli-fin .sec-title td {
                background: #C9962F; color: #111; font-weight: bold;
                text-transform: uppercase; font-size: 10px; border: none;
            }
            .pierinelli-fin .total-row td {
                border-top: 2px solid #111; border-bottom: 2px solid #111;
                font-weight: bold; background: #faf6ec;
            }
            .pierinelli-fin .grand-total td {
                border-top: 3px double #111; font-weight: bold;
                background: #111; color: #fff;
            }
            .pierinelli-fin .kpi-box {
                display: inline-block; width: 23%; margin: 0 1% 8px 0;
                border: 1px solid #C9962F; border-radius: 6px; padding: 8px;
                text-align: center; vertical-align: top;
            }
            .pierinelli-fin .kpi-box .kpi-val { font-size: 15px; font-weight: bold; color: #111; }
            .pierinelli-fin .kpi-box .kpi-lbl { font-size: 8px; color: #777; text-transform: uppercase; }
            .pierinelli-fin .footnote { color: #999; font-size: 8px; margin-top: 6px; font-style: italic; }
        </style>
    </template>

    <template id="financial_report_header">
        <div class="pierinelli-fin">
            <table style="width:100%; border:none; margin-bottom:6px;">
                <tr>
                    <td style="border:none; width:60%;">
                        <h2 t-esc="title"/>
                        <div class="subtitle">PIERINELLI</div>
                    </td>
                    <td style="border:none; text-align:right;" class="fin-meta">
                        <div><strong t-esc="doc['header']['company']"/></div>
                        <div t-if="doc['header']['ruc']">RUC: <span t-esc="doc['header']['ruc']"/></div>
                        <div>Del <span t-esc="doc['header']['date_from']"/>
                             al <span t-esc="doc['header']['date_to']"/></div>
                        <div t-esc="doc['header']['target_move']"/>
                        <div>Expresado en Soles (PEN)</div>
                    </td>
                </tr>
            </table>
        </div>
    </template>

</odoo>
