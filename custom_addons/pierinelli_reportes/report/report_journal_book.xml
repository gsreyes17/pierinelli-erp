<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_journal_book_doc">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page pierinelli-fin">
                    <t t-call="pierinelli_reportes.financial_report_styles"/>
                    <t t-call="pierinelli_reportes.financial_report_header">
                        <t t-set="title">Libro Diario</t>
                    </t>

                    <p class="fin-meta" style="margin-bottom:8px;">
                        <strong t-esc="doc['count']"/> asientos en el periodo ·
                        Total Debe <strong t-esc="doc['total_debit_s']"/> ·
                        Total Haber <strong t-esc="doc['total_credit_s']"/>
                    </p>

                    <t t-foreach="doc['entries']" t-as="e">
                        <table style="margin-bottom:10px;">
                            <thead>
                                <tr class="sec-title">
                                    <td colspan="5">
                                        <span t-esc="e['name']"/> ·
                                        <span t-esc="e['date']"/> ·
                                        <span t-esc="e['journal']"/>
                                        <span t-if="e['ref']"> · Ref: <t t-esc="e['ref']"/></span>
                                        <span style="float:right;" t-esc="e['state']"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th style="width:34%;">Cuenta</th>
                                    <th>Concepto</th>
                                    <th style="width:16%;">Tercero</th>
                                    <th class="num" style="width:12%;">Debe</th>
                                    <th class="num" style="width:12%;">Haber</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="e['lines']" t-as="l">
                                    <td t-esc="l['account']"/>
                                    <td t-esc="l['label']"/>
                                    <td t-esc="l['partner']"/>
                                    <td class="num" t-esc="l['debit_s']"/>
                                    <td class="num" t-esc="l['credit_s']"/>
                                </tr>
                                <tr class="total-row">
                                    <td colspan="3">Total asiento</td>
                                    <td class="num" t-esc="e['debit_s']"/>
                                    <td class="num" t-esc="e['credit_s']"/>
                                </tr>
                            </tbody>
                        </table>
                    </t>

                    <p t-if="not doc['entries']" class="footnote">
                        No hay asientos en el periodo seleccionado.
                    </p>
                    <p class="footnote">
                        Registro cronologico de los asientos contables del periodo.
                        Documento de gestion interna (el Libro Diario oficial PLE/SUNAT
                        requiere el formato electronico normado).
                    </p>
                </div>
            </t>
        </t>
    </template>

</odoo>
