<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Hueso: planchas con mas de 1 anio en almacen quedan marcadas
             para gestion (pasar a oferta o liquidacion). -->
        <record id="cron_marcar_hueso" model="ir.cron">
            <field name="name">Planchas: marcar condicion Hueso</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="state">code</field>
            <field name="code">model._cron_marcar_hueso()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Reservas: la regla de los 7 dias. Vencida la fecha fin,
             la plancha vuelve a estar disponible automaticamente. -->
        <record id="cron_liberar_reservas" model="ir.cron">
            <field name="name">Planchas: liberar reservas vencidas</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="state">code</field>
            <field name="code">model._cron_liberar_reservas()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
