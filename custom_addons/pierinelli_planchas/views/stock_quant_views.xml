<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ajustes de inventario: columna de MOTIVO (obligatoria para aplicar) -->
    <record id="view_stock_quant_tree_motivo" model="ir.ui.view">
        <field name="name">stock.quant.inventory.motivo</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inventory_diff_quantity']" position="after">
                <field name="motivo_ajuste" optional="show"
                       placeholder="Rotura, conteo, extravio..."/>
            </xpath>
        </field>
    </record>

</odoo>
