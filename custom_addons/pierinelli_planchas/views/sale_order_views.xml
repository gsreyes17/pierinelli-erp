<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Columna "Plancha" en las lineas del pedido de venta: el vendedor
         aparta LA plancha concreta que el cliente eligio. -->
    <record id="view_order_form_plancha" model="ir.ui.view">
        <field name="name">sale.order.form.plancha</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']"
                   position="before">
                <!-- unidad_venta debe estar en la vista aunque se oculte: el
                     dominio de plancha_id la referencia y sin ella no evalua. -->
                <field name="unidad_venta" optional="show"/>
                <field name="plancha_id" optional="show"
                       options="{'no_create': True}"/>
                <field name="plancha_m2" optional="hide"/>
                <!-- Losas pre-cortadas: se captura en piezas y el sistema
                     convierte a m² (lo que realmente mueve el stock). -->
                <field name="cantidad_piezas" optional="show"
                       readonly="unidad_venta != 'piezas'"/>
                <field name="m2_por_pieza" optional="hide"/>
                <field name="piezas_disponibles" optional="hide"/>
                <field name="precio_por_pieza" optional="hide"/>
            </xpath>
            <!-- Pedido <-> Ordenes de Corte -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ver_ordenes_corte" type="object"
                        class="oe_stat_button" icon="fa-scissors"
                        invisible="orden_corte_count == 0">
                    <field name="orden_corte_count" widget="statinfo"
                           string="Ordenes de corte"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_crear_orden_corte" type="object"
                        string="Crear Orden de Corte"
                        invisible="state != 'sale'"
                        groups="stock.group_stock_user"/>
            </xpath>
        </field>
    </record>

    <!-- Factura <-> Ordenes de Corte -->
    <record id="view_move_form_orden_corte" model="ir.ui.view">
        <field name="name">account.move.form.orden.corte</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ver_ordenes_corte" type="object"
                        class="oe_stat_button" icon="fa-scissors"
                        invisible="orden_corte_count == 0">
                    <field name="orden_corte_count" widget="statinfo"
                           string="Ordenes de corte"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
