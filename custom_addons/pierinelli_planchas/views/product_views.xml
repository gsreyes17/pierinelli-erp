<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Producto: tipo de material + prefijo + boton de planchas -->
    <record id="view_product_template_form_plancha" model="ir.ui.view">
        <field name="name">product.template.form.plancha</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ver_planchas" type="object"
                        class="oe_stat_button" icon="fa-th-large"
                        invisible="tracking != 'lot'">
                    <field name="plancha_count" widget="statinfo"
                           string="Planchas"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="tipo_material" invisible="type == 'service'"/>
                <field name="prefijo_plancha"
                       invisible="tracking != 'lot'"/>
            </xpath>
        </field>
    </record>

</odoo>
