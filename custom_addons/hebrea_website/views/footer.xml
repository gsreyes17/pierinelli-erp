<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="footer_hebrea" inherit_id="website.footer_custom" name="Footer - Academia Hebrea">
        <xpath expr="//div[@id='footer']" position="inside">
            <section id="contacto" class="hb-footer">
                <div class="container">
                    <div class="row g-4 py-5">
                        <div class="col-lg-5">
                            <span class="hb-footer-brand">Academia <span class="hb-gold-italic">Hebrea</span></span>
                            <p class="hb-text-light mt-3" style="max-width: 380px;">
                                Educación integral judía y trilingüe desde 1979. Parvularia, Primaria y
                                Secundaria en un mismo camino de excelencia y valores.
                            </p>
                        </div>
                        <div class="col-6 col-lg-2">
                            <h5 class="hb-footer-title">Explora</h5>
                            <ul class="hb-footer-links">
                                <li><a href="#academia">Academia</a></li>
                                <li><a href="#admisiones">Admisiones</a></li>
                                <li><a href="#historia">Historia</a></li>
                            </ul>
                        </div>
                        <div class="col-6 col-lg-2">
                            <h5 class="hb-footer-title">Recursos</h5>
                            <ul class="hb-footer-links">
                                <li><a href="#">Portal RenWeb</a></li>
                                <li><a href="#">Biblioteca</a></li>
                                <li><a href="#vida">Vida Estudiantil</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-3">
                            <h5 class="hb-footer-title">Contacto</h5>
                            <ul class="hb-footer-links">
                                <li><i class="fa fa-map-marker me-2"/>Ciudad de Panamá, Panamá</li>
                                <li><i class="fa fa-envelope-o me-2"/>info@academiahebrea.com</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
