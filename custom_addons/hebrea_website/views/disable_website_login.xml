<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Al instalar 'website', su plantilla 'website.login_layout' reemplaza el login
      con el layout del sitio (logo y chrome del sitio web). En este entorno el login
      es del ERP Pierinelli, no del sitio Academia Hebrea. Desactivamos esa toma de
      control para que el login use la marca Pierinelli (web.login_layout + branding).
    -->
    <record id="website.login_layout" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
</odoo>
