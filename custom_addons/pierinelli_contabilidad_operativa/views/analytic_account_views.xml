<odoo>
    <!-- Botones "Pedidos" y "Facturas" en la ficha de la obra/cuenta
         analitica: la obra como centro de consulta de sus documentos. -->
    <record id="view_analytic_account_form_documentos" model="ir.ui.view">
        <field name="name">account.analytic.account.form.documentos</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ver_pedidos" type="object"
                        class="oe_stat_button" icon="fa-shopping-cart"
                        invisible="pedidos_count == 0">
                    <field name="pedidos_count" widget="statinfo"
                           string="Pedidos"/>
                </button>
                <button name="action_ver_facturas" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="facturas_count == 0">
                    <field name="facturas_count" widget="statinfo"
                           string="Facturas"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
