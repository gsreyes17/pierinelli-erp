<odoo>
    <record id="action_descargar_plantilla_asientos" model="ir.actions.act_window">
        <field name="name">Plantilla de asientos</field>
        <field name="res_model">pierinelli.descargar.plantilla.asientos</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="action_importar_asientos" model="ir.actions.act_window">
        <field name="name">Importar asientos desde Excel</field>
        <field name="res_model">pierinelli.importar.asientos</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_descargar_plantilla_asientos_form" model="ir.ui.view">
        <field name="name">pierinelli.descargar.plantilla.asientos.form</field>
        <field name="model">pierinelli.descargar.plantilla.asientos</field>
        <field name="arch" type="xml">
            <form string="Plantilla Excel de asientos">
                <group>
                    <p>Descargue la plantilla, elimine las filas grises de ejemplo y complete una línea por apunte. La hoja Instrucciones explica cada columna.</p>
                    <field name="archivo" filename="archivo_nombre" readonly="1"/>
                    <field name="archivo_nombre" invisible="1"/>
                </group>
                <footer><button string="Cerrar" special="cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="view_importar_asientos_form" model="ir.ui.view">
        <field name="name">pierinelli.importar.asientos.form</field>
        <field name="model">pierinelli.importar.asientos</field>
        <field name="arch" type="xml">
            <form string="Importar asientos desde Excel">
                <group>
                    <p>Solo use la plantilla descargada desde esta pantalla. Antes de crear algo, el sistema valida encabezados, diarios, cuentas, fecha y que cada asiento cuadre.</p>
                    <field name="archivo" filename="archivo_nombre"/>
                    <field name="archivo_nombre" invisible="1"/>
                    <p class="text-muted">La importación crea únicamente asientos en borrador; revíselos y publíquelos individualmente después.</p>
                </group>
                <footer>
                    <button name="action_importar" type="object" string="Validar e importar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_move_tree_importar_asientos" model="ir.ui.view">
        <field name="name">account.move.list.importar.asientos</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(action_descargar_plantilla_asientos)d" type="action"
                            string="Plantilla Excel" icon="fa-download"
                            groups="account.group_account_user,base.group_system"/>
                    <button name="%(action_importar_asientos)d" type="action"
                            string="Importar asientos" class="btn-primary" icon="fa-upload"
                            groups="account.group_account_user,base.group_system"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
