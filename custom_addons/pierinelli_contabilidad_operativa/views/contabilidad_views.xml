<odoo>
    <record id="action_panel_contable" model="ir.actions.client">
        <field name="name">Panel Contable</field>
        <field name="tag">pierinelli_contabilidad_operativa.panel</field>
    </record>
    <menuitem id="menu_panel_contable" name="Panel Contable" parent="account.menu_finance"
              action="action_panel_contable" sequence="1"
              groups="account.group_account_user,base.group_system"/>

    <record id="view_caja_chica_list" model="ir.ui.view">
        <field name="name">pierinelli.caja.chica.list</field>
        <field name="model">pierinelli.caja.chica</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="responsable_id"/>
                <field name="fondo_fijo"/>
                <field name="gastos"/>
                <field name="total_repuesto"/>
                <field name="saldo_teorico"/>
                <field name="diferencia_arqueo"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_caja_chica_form" model="ir.ui.view">
        <field name="name">pierinelli.caja.chica.form</field>
        <field name="model">pierinelli.caja.chica</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_abrir" type="object" string="Abrir caja" class="btn-primary"
                            invisible="state != 'borrador'"/>
                    <button name="action_reponer" type="object" string="Reponer desde banco" class="btn-secondary"
                            invisible="state != 'abierta'"/>
                    <button name="action_ajustar_arqueo" type="object" string="Ajustar diferencia de arqueo" class="btn-secondary"
                            invisible="state != 'abierta' or diferencia_arqueo == 0"/>
                    <button name="action_cerrar" type="object" string="Cerrar caja" class="btn-primary"
                            invisible="state != 'abierta'"/>
                    <field name="state" widget="statusbar" statusbar_visible="borrador,abierta,cerrada"/>
                </header>
                <sheet>
                    <group>
                        <group string="Configuracion">
                            <field name="name"/>
                            <field name="responsable_id"/>
                            <field name="journal_id"/>
                            <field name="journal_reposicion_id"/>
                            <field name="cuenta_faltante_id"/>
                            <field name="cuenta_sobrante_id"/>
                            <field name="currency_id" readonly="state != 'borrador'"/>
                        </group>
                        <group string="Control de efectivo">
                            <field name="fondo_fijo" readonly="state != 'borrador'"/>
                            <field name="apertura_move_id" readonly="1"/>
                            <field name="fecha_apertura"/>
                            <field name="fecha_cierre"/>
                            <field name="gastos" readonly="1"/>
                            <field name="total_repuesto" readonly="1"/>
                            <field name="total_ajuste_arqueo" readonly="1"/>
                            <field name="saldo_teorico" readonly="1"/>
                            <field name="arqueo_real" readonly="state == 'cerrada'"/>
                            <field name="diferencia_arqueo" readonly="1"/>
                            <field name="arqueo_confirmado" readonly="state == 'cerrada'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Movimientos">
                            <field name="movimiento_ids" readonly="state != 'abierta'">
                                <list editable="bottom">
                                    <field name="fecha"/>
                                    <field name="partner_id"/>
                                    <field name="tipo_comprobante_id"/>
                                    <field name="documento"/>
                                    <field name="descripcion"/>
                                    <field name="cuenta_gasto_id"/>
                                    <field name="importe"/>
                                    <field name="state"/>
                                    <button name="action_contabilizar" type="object" string="Contabilizar"
                                            invisible="state != 'borrador'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reposiciones">
                            <field name="reposicion_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="fecha"/>
                                    <field name="importe"/>
                                    <field name="move_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ajustes de arqueo">
                            <field name="arqueo_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="fecha"/>
                                    <field name="diferencia"/>
                                    <field name="move_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_caja_chica" model="ir.actions.act_window">
        <field name="name">Caja Chica</field>
        <field name="res_model">pierinelli.caja.chica</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_caja_chica" name="Caja Chica" parent="account.menu_finance_entries"
              action="action_caja_chica" sequence="25" groups="account.group_account_user,base.group_system"/>

    <record id="view_control_tributario_list" model="ir.ui.view">
        <field name="name">pierinelli.control.tributario.list</field>
        <field name="model">pierinelli.control.tributario</field>
        <field name="arch" type="xml">
            <list>
                <field name="fecha"/>
                <field name="move_id"/>
                <field name="tipo"/>
                <field name="porcentaje"/>
                <field name="base"/>
                <field name="importe"/>
                <field name="constancia"/>
                <field name="estado" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_control_tributario" model="ir.actions.act_window">
        <field name="name">Detracciones y Retenciones</field>
        <field name="res_model">pierinelli.control.tributario</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_control_tributario" name="Detracciones y Retenciones" parent="account.menu_finance_entries"
              action="action_control_tributario" sequence="26" groups="account.group_account_user,base.group_system"/>
</odoo>
