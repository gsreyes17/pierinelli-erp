<odoo>
    <!-- Gestión de áreas: lista propia, ya filtrada al plan de Áreas y con
         el plan puesto por defecto al crear (el usuario no tiene que saber
         de "planes analíticos" para dar de alta un área). -->
    <record id="view_area_list" model="ir.ui.view">
        <field name="name">account.analytic.account.list.areas</field>
        <field name="model">account.analytic.account</field>
        <field name="arch" type="xml">
            <list string="Áreas / Centros de Costo" editable="bottom">
                <field name="code" string="Código"/>
                <field name="name" string="Área"/>
                <field name="plan_id" column_invisible="True"/>
                <field name="company_id" optional="hide"/>
                <field name="balance" string="Saldo analítico" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_areas" model="ir.actions.act_window">
        <field name="name">Áreas / Centros de Costo</field>
        <field name="res_model">account.analytic.account</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_area_list"/>
        <field name="domain" eval="[('plan_id', '=', ref('plan_areas'))]"/>
        <!-- `ref()` debe resolverse al cargar los datos XML; si se deja como
             texto llega al navegador y su evaluador no conoce esa función. -->
        <field name="context" eval="{'default_plan_id': ref('plan_areas')}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea la primera área</p>
            <p>Las áreas son los centros de costo de la empresa: Finanzas,
               Marketing, Tecnología, Comercial… Cada gasto puede imputarse a
               su área, y el presupuesto se reparte por ellas.</p>
        </field>
    </record>

    <menuitem id="menu_areas" name="Áreas / Centros de Costo"
              parent="account.menu_finance_configuration"
              action="action_areas" sequence="32"
              groups="analytic.group_analytic_accounting,base.group_system"/>
</odoo>
