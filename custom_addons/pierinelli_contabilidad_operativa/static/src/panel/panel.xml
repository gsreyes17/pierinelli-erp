<templates xml:space="preserve"><t t-name="pierinelli_contabilidad_operativa.Panel"><div class="o_pier_account_panel"><div class="o_pier_account_hero"><div><h1>Centro Financiero</h1><p>Operación, tesorería y control económico en un solo lugar.</p></div><button class="btn btn-light" t-on-click="load" t-att-disabled="state.loading"><i class="fa fa-refresh me-1"/> Actualizar</button></div><div t-if="state.error" class="alert alert-warning mt-3" role="alert">No se pudieron actualizar los indicadores. Los accesos siguen disponibles; vuelva a pulsar <strong>Actualizar</strong> en unos segundos.</div><h3>Operación diaria</h3><div class="o_pier_account_cards"><button t-on-click="openReceivables"><i class="fa fa-file-text-o"/> Facturación y cobros<strong t-esc="state.data.por_cobrar"/><small>Documentos por cobrar</small></button><button t-on-click="openPayables"><i class="fa fa-truck"/> Compras y pagos<strong t-esc="state.data.por_pagar"/><small>Documentos por pagar</small></button><button t-on-click="openDrafts"><i class="fa fa-pencil-square-o"/> Asientos<strong t-esc="state.data.borradores"/><small>Borradores por revisar</small></button></div><h3>Tesorería y cumplimiento</h3><div class="o_pier_account_cards"><button t-on-click="openCash"><i class="fa fa-money"/> Caja chica<strong t-esc="state.data.cajas_abiertas"/><small>Cajas abiertas</small></button><button t-on-click="openReconciliations"><i class="fa fa-calculator"/> Arqueos diarios<strong t-esc="state.data.arqueos_pendientes"/><small>Pendientes de cerrar</small></button><button t-on-click="openTaxes"><i class="fa fa-check-square-o"/> Tributos<strong t-esc="state.data.tributos_pendientes"/><small>Controles pendientes</small></button><button t-on-click="openTemplates"><i class="fa fa-repeat"/> Asientos tipo<strong>+</strong><small>Provisión y depreciación</small></button></div><h3>Planificación y análisis</h3><div class="o_pier_account_cards"><button t-on-click="openBudgets"><i class="fa fa-line-chart"/> Presupuestos<strong t-esc="state.data.presupuestos_abiertos"/><small>Períodos aprobados</small></button></div></div></t></templates>
